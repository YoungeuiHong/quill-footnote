{
  "name": "quill-footnote",
  "version": "1.0.2",
  "description": "A Quill editor module that enables easy insertion, editing, and management of footnotes.",
  "main": "dist/quill-footnote.cjs.js",
  "module": "dist/quill-footnote.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/quill-footnote.esm.js",
      "require": "./dist/quill-footnote.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/quill-footnote.css": "./dist/quill-footnote.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && rollup -c",
    "prepublishOnly": "yarn build",
    "dev": "cd demo && vite"
  },
  "author": "Youngeui Hong",
  "license": "MIT",
  "keywords": [
    "quill",
    "quilljs",
    "footnote",
    "annotation"
  ],
  "peerDependencies": {
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.35.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.2",
    "vite": "^5.0.0"
  }
}
